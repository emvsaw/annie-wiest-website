---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { site } from '../../../data/site';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const paths = [];
  for (const chapter of chapters) {
    const book = await getEntry('books', chapter.data.bookSlug);
    if (book) {
      paths.push({ params: { slug: chapter.data.bookSlug }, props: { chapter } });
    }
  }
  return paths;
}

const { chapter } = Astro.props;
const book = await getEntry('books', chapter.data.bookSlug);
const { Content } = await render(chapter);
const year = new Date().getFullYear();
---

<BaseLayout
  title={`${chapter.data.title || 'Chapter 1'} from ${book.data.title} | ${site.name}`}
  description={`Read the first chapter of ${book.data.title} by ${site.name}.`}
  ogImage={book.data.cover}
>
  <div class="container chapter-reader-layout">
    <div class="chapter-reader">
      <p class="chapter-back"><a href={`/books/${book.data.slug}/`}>&larr; Back to {book.data.title}</a></p>

      <p class="eyebrow">{book.data.title}</p>
      <h1>{chapter.data.title || 'Chapter 1'}</h1>

      {chapter.data.audioFile && (
        <div class="chapter-audio">
          <audio controls src={chapter.data.audioFile}>
            Your browser does not support the audio element.
          </audio>
        </div>
      )}

      <div class="chapter-body">
        <Content />
      </div>

      <p class="chapter-copyright">
        Copyright &copy; {year} {site.name}. All rights reserved. <em>{book.data.title}</em> is a work of fiction.
      </p>

      <div class="chapter-cta">
        <p>Want to keep reading?</p>
        {book.data.buyLink && (
          <a href={book.data.buyLink} class="btn btn-primary" target="_blank" rel="noopener">
            {book.data.preorder ? 'Preorder Now' : 'Buy Now'}
          </a>
        )}
        <a href={`/books/${book.data.slug}/`} class="btn btn-outline">Back to {book.data.title}</a>
      </div>
    </div>

    <aside class="chapter-sidebar">
      <div class="chapter-sidebar-inner">
        <img src={book.data.cover} alt={book.data.title} loading="lazy" />
        {book.data.buyLink && (
          <a href={book.data.buyLink} class="btn btn-primary" target="_blank" rel="noopener">
            {book.data.preorder ? 'Preorder Now' : 'Buy Now'}
          </a>
        )}
      </div>
    </aside>
  </div>

  <section class="newsletter-band" id="newsletter">
    <div class="container">
      <h2>Want More Sapphic Ranch Romance?</h2>
      <p style="max-width: 560px; margin-left: auto; margin-right: auto;">
        Join my mailing list for exclusive free stories, new release news, and behind-the-scenes
        updates from Sacred Peaks Ranch. No spam, ever, unsubscribe any time.
      </p>
      <form class="nl-form" data-action={site.newsletterFormAction}>
        <input type="text" name="fields[name]" placeholder="First Name" autocomplete="given-name" />
        <input type="email" name="fields[email]" placeholder="Email Address" autocomplete="email" required />
        <button type="submit" class="btn btn-primary">Get My Free Content</button>
      </form>
      <p class="form-success" style="color:#fff;">Almost there! Check your inbox and click the confirmation link to complete your signup.</p>
      <p class="form-error" style="color:#ffb4a8;">Something went wrong. Please try again, or email me directly.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('.nl-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const action = form.dataset.action;
    const formData = new FormData(form);
    formData.append('ml-submit', '1');
    formData.append('anticsrf', 'true');
    try {
      const res = await fetch(action!, { method: 'POST', body: formData });
      const result = await res.json();
      if (result.success) {
        form.style.display = 'none';
        document.querySelector('.form-success')!.setAttribute('style', 'display:block; color:#fff; font-weight:600;');
      } else {
        document.querySelector('.form-error')!.setAttribute('style', 'display:block; color:#ffb4a8; font-weight:600;');
      }
    } catch (_) {
      document.querySelector('.form-error')!.setAttribute('style', 'display:block; color:#ffb4a8; font-weight:600;');
    }
  });
</script>
